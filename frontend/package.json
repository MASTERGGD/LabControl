{
  "name": "labcontrol-frontend",
  "version": "1.0.1",
  "private": true,
  "dependencies": {
    "axios": "^1.21.0",
    "blendy": "^0.0.1",
    "date-fns": "^3.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.0",
    "babel-jest": "^30.5.2",
    "fake-indexeddb": "^6.2.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.0",
    "vite": "^8.3.6"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "test": "jest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/test/styleMock.cjs",
      "\\.(png|jpg|jpeg|gif|svg|webp)$": "<rootDir>/test/fileMock.cjs"
    },
    "resetMocks": true
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
